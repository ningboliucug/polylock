# Operating system and editor files
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Build outputs
bin/
*.exe
*.out
*.test

# Logs
*.log

# Runtime data generated by Docker/IPFS experiments
deployments/docker/ipfs-data/*
!deployments/docker/ipfs-data/.gitkeep
deployments/docker/shared-data/*
!deployments/docker/shared-data/.gitkeep

# Temporary Python/cache files
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local archives
archive/*.zip
